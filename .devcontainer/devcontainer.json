{
  "name": "shelf",
  "build": { "dockerfile": "Dockerfile" },

  // Fixed name so hack/nuke.sh can remove it by exact name.
  "runArgs": ["--name", "shelf-devcontainer"],

  // Docker-in-Docker: a private Docker daemon runs inside this container (the feature makes the
  // container privileged). The k3d cluster lives in that daemon, not next to the host's other
  // containers. "moby": false installs Docker CE; moby has no packages for Debian trixie.
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "moby": false,
      "version": "29.8.1",
      "dockerDashComposeVersion": "none",
      "installDockerBuildx": false
    }
  },

  "remoteUser": "vscode",
  "remoteEnv": {
    // The only kubeconfig tooling in this container should ever use.
    "KUBECONFIG": "/home/vscode/.kube/shelf-dev.yaml",
    // Marks the shelf devcontainer; hack/lib.sh requires it and hack/nuke.sh refuses it.
    "SHELF_DEVCONTAINER": "1"
  },

  // Every volume here is listed in the footprint inventory in docs/plan.md and removed by
  // hack/nuke.sh. Add new ones in all three places.
  // The last two replace the docker-in-docker feature's own mounts for the same targets, whose
  // names contain a generated ID; fixed names keep exact-name cleanup possible.
  "mounts": [
    "source=shelf-gomodcache,target=/go/pkg/mod,type=volume",
    "source=shelf-gocache,target=/home/vscode/.cache/go-build,type=volume",
    "source=shelf-claude-config,target=/home/vscode/.claude,type=volume",
    "source=shelf-docker,target=/var/lib/docker,type=volume",
    "source=shelf-containerd,target=/var/lib/containerd,type=volume"
  ],

  "forwardPorts": [8080],

  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "redhat.vscode-yaml",
        "anthropic.claude-code"
      ]
    }
  }
}
